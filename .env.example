# ── Willow Weave environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. With NO keys set, the app runs fully in
# LOCAL MODE: catalog from data/, orders saved to data/dev/orders.json,
# emails logged to the console. Perfect for reviewing the site before
# creating any accounts.

# Supabase (https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (https://cloudinary.com → Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=
# Sender address. Until willowweave.co is verified in Resend, use
# onboarding@resend.dev (it can only deliver to the account owner's inbox).
EMAIL_FROM="Willow Weave <onboarding@resend.dev>"
# Where new-order notifications go (also editable in the admin dashboard).
ORDER_NOTIFY_EMAIL=you@example.com

# Absolute URL of the deployed site (used in emails + metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the daily Supabase keepalive cron (any random string)
CRON_SECRET=
